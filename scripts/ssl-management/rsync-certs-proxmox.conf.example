# Proxmox SSL Sync Configuration Example
# Legacy per-script config. Prefer SSL_* settings in /etc/infrastack/infrastack.conf
# (see configs/infrastack.conf.example); values here override those.

# ===== Remote Certificate Source =====
# For external servers:
REMOTEHOST=web1.example.com
REMOTEPORT=2200

# For pve1 (web1 is local VM):
# REMOTEHOST=192.168.1.100
# REMOTEPORT=22

# ===== Optional Overrides =====
# REMOTEUSER="certuser"
# REMOTEDIR=/home/certuser/
# LOCALDIR=/tmp/ssl-staging/
# PROXMOX_CERT_DIR=/etc/pve/local
# LOG_FILE=/var/log/ssl-cert-sync.log
