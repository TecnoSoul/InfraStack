# =============================================================================
# stack n8n-ai — variables de entorno
# Copiar a .env con scripts/gen-env.sh (genera los secretos). Nunca commitear .env.
# =============================================================================

# --- Versión -----------------------------------------------------------------
# Fijar siempre una versión concreta (nunca "latest"). Última estable:
# https://github.com/n8n-io/n8n/releases  — la misma tag se usa para n8nio/runners
N8N_VERSION=2.48.8

# --- URL pública ---------------------------------------------------------------
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
N8N_PUBLIC_URL=https://n8n.example.com/
# true detrás de HTTPS. Solo para una prueba inicial por http://IP:5678 poner false
N8N_SECURE_COOKIE=true

# --- Acceso -------------------------------------------------------------------
# Opción A (recomendada): Cloudflare Tunnel + Access
#   COMPOSE_PROFILES=tunnel, N8N_BIND_ADDR=127.0.0.1 y el token del túnel.
# Opción B: reverse proxy propio (NPM)
#   COMPOSE_PROFILES vacío, N8N_BIND_ADDR=0.0.0.0 + firewall para que solo llegue NPM.
COMPOSE_PROFILES=
N8N_BIND_ADDR=0.0.0.0
# Token del túnel (Zero Trust → Networks → Tunnels). Es un secreto: va solo en .env.
CLOUDFLARE_TUNNEL_TOKEN=
# Versión fija de cloudflared: https://github.com/cloudflare/cloudflared/releases
CLOUDFLARED_VERSION=2026.11.2

TZ=America/Argentina/Buenos_Aires

# --- Secretos (los genera scripts/gen-env.sh) ---------------------------------
# Guardar N8N_ENCRYPTION_KEY en Vaultwarden: sin ella un backup no sirve.
N8N_ENCRYPTION_KEY=__GENERATE__
N8N_RUNNERS_AUTH_TOKEN=__GENERATE__

# --- Postgres ----------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=n8n
POSTGRES_NON_ROOT_USER=n8n
POSTGRES_NON_ROOT_PASSWORD=__GENERATE__
